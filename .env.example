# Окружение API и сохранённых служебных CLI Speech Analytics.
# Docker Compose запускает только API и миграции: docs/deployment.md.
# Настройки обработки ниже пока нужны сохранённым CLI; отдельный воркер
# настраивается через собственный .env.example в speech-worker.

# Окружение. Режим входа `open` разрешён только в local и alpha.
APP_ENV=local

# --- База данных -------------------------------------------------------------
# Своя база `speech`: у сервиса нет ни одной связи с таблицами основного
# приложения, и своё дерево миграций (`alembic_speech`).
#
# Запуск без Docker читает адрес отсюда. Обязательна: в монорепозитории пустое
# значение означало откат на `DATABASE_URL` основного приложения, здесь отката
# нет — без адреса не стартуют ни миграции, ни сервис, ни воркеры.
SPEECH_MS_DATABASE_URL=
# В Docker адрес приходит контейнерам из двух переменных ниже: службам — роль
# `speech_ms_runtime`, миграциям — `speech_ms_migrate`. Подставьте в каждую
# соответствующий пароль. Строки записаны целиком, а не собираются из
# переменных, намеренно: строка подключения, собранная из трёх других
# переменных, падает в рантайме с ошибкой аутентификации, не называя ни одной.
AICISTENT_DOCKER_SPEECH_MS_DATABASE_URL=postgresql+asyncpg://speech_ms_runtime:<SPEECH_MS_DB_PASSWORD>@db_postgres:5432/speech_whisper
AICISTENT_DOCKER_SPEECH_MS_MIGRATE_DATABASE_URL=postgresql+asyncpg://speech_ms_migrate:<SPEECH_MS_MIGRATE_DB_PASSWORD>@db_postgres:5432/speech_whisper
# Пароли ролей БД. Роли создаются sql/grants/ в aicistent-infrastructure.
SPEECH_MS_DB_PASSWORD=
SPEECH_MS_MIGRATE_DB_PASSWORD=

# --- Docker ------------------------------------------------------------------
# Существующая сеть с доступом к PostgreSQL для API и миграций.
# Укажите сеть своей базы или создайте speech-data для внешнего сервера.
# Compose не создаёт эту сеть; порядок настройки — docs/deployment.md.
SPEECH_DOCKER_NETWORK=speech-data
# Порт API на петле (127.0.0.1).
AICISTENT_SPEECH_MS_DOCKER_PORT=18096
# Образы. Пусто — speech-backend:local и speech-backend-migrations:local.
SPEECH_MS_IMAGE=
SPEECH_MIGRATIONS_IMAGE=

# --- Вход и браузер ----------------------------------------------------------
# Источники, которым разрешён CORS, через запятую.
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:5173,http://localhost:5174
# Флаг `Secure` на куках `speech_session`, `speech_login` и `speech_audio`:
# auto|always|never.
#
# `auto` (умолчание) — флаг стоит везде, кроме APP_ENV=local; в local схему
# ещё можно сообщить запросом или `X-Forwarded-Proto`.
# `always` — флаг стоит всегда, в том числе в local.
# `never` — флага нет. В продуктиве (APP_ENV=prod/production) процесс с этим
# значением не стартует; в local и alpha разрешено, и это отладочный режим для
# прямого входа по http мимо корпоративного прокси: с `Secure` браузер куку по
# http не возвращает, и вход зацикливается на `?auth_error=state_mismatch`.
#
# Имя переменной то же, что у основного приложения. Подробности —
# src/presentation/http/cookies.py.
SESSION_COOKIE_SECURE=auto

# --- Speech Analytics (speech-ms) -------------------------------------------
# Режим входа: keycloak | open.
#
# `open` отключает аутентификацию целиком: все запросы выполняются от
# синтетического администратора. Он существует, пока проекту не выделен
# отдельный экземпляр Keycloak, и его единственная защита — сетевое
# ограничение. Процесс отказывается стартовать с этим значением, если APP_ENV
# не local и не alpha; это не предупреждение в логе, а отказ запуска.
SPEECH_AUTH_MODE=open

# Требуются при SPEECH_AUTH_MODE=keycloak — все три, иначе сервис не стартует.
# Экземпляр отдельный от dev-keycloak-assistant: у проекта своя ролевая модель.
SPEECH_KEYCLOAK_ISSUER_URL=
SPEECH_KEYCLOAK_JWKS_URL=
SPEECH_KEYCLOAK_AUDIENCE=

# Читает КОНТЕЙНЕР ФРОНТА в рантайме через /config.json — отдельно от трёх
# переменных выше, которые читает сервис. Разные потребители, разные имена:
# сервису нужен issuer и ключи для проверки токена, браузеру — адрес, realm
# и идентификатор клиента, чтобы этот токен получить.
#
# Клиент `speech` в realm IC-GROUP — КОНФИДЕНЦИАЛЬНЫЙ, и таким останется:
# правок на стороне Keycloak не будет. Поэтому обмен кода на токен делает
# СЕРВИС, а не браузер (ADR-SPEECH-0002): секрет не покидает сервер, браузеру
# достаётся непрозрачная кука сессии.
#
# Проверено живьём: запрос к token без секрета отвечает `unauthorized_client`,
# тогда как несуществующее имя клиента — `invalid_client`.
SPEECH_KEYCLOAK_URL=
SPEECH_KEYCLOAK_REALM=
SPEECH_KEYCLOAK_CLIENT_ID=
SPEECH_KEYCLOAK_RESPONSE_MODE=fragment
SPEECH_KEYCLOAK_SCOPE=openid profile email
SPEECH_KEYCLOAK_PKCE_ENABLED=true

# Секрет клиента. Берётся в Keycloak: клиент `speech` → вкладка Credentials.
# Без него в режиме keycloak сервис не стартует — войти всё равно не смог бы
# никто, а отказ на старте виден раньше, чем отказ на экране входа.
SPEECH_KEYCLOAK_CLIENT_SECRET=

# Публичный адрес приложения. От него собирается redirect_uri, и Keycloak
# сверяет его побайтово со своим списком. Должно быть ровно то, что
# зарегистрировано в клиенте, без завершающей косой черты.
#
# Проверено: `https://speech.ic-group.ru/api/v1/auth/callback` принимается, а
# любые localhost и 127.0.0.1 — отвергаются. Значит вход целиком проверяется
# только на настоящем домене.
SPEECH_PUBLIC_BASE_URL=

# Сколько живёт сессия браузера без обращений и как часто перечитываются роли.
# Обновление по refresh_token заодно отвечает, жив ли человек в Keycloak:
# `invalid_grant` означает отзыв, и тогда сессия гасится и у нас.
SPEECH_SESSION_TTL_SECONDS=43200
SPEECH_SESSION_REFRESH_SECONDS=900

# Адрес API для фронта. Пусто — «тот же источник»: фронт и API за одним
# прокси, и относительный путь надёжнее записанного адреса.
SPEECH_API_URL=

# Соответствие групп Keycloak ролям сервиса. Пусто — берётся умолчание из
# src/domain/calls/contracts.py: whisper-icg-readers / -editors / -admins.
SPEECH_ROLE_ALIASES_JSON={}

# Часовой пояс отображения. Хранится всё в timestamptz; это только показ.
SPEECH_DISPLAY_TIMEZONE=Europe/Moscow

# --- Naumen Contact Center --------------------------------------------------
# Два независимых источника, и это не дублирование. REST отдаёт аудиозапись по
# идентификатору сессии и справочники сотрудников и проектов; списка звонков в
# нём нет вовсе — список берётся из отчётной базы. Отсюда две учётные записи.
#
# REST. Аутентификация заголовками `Username` и `X-API-Key`. Базовый адрес
# включает версию: путь `/callrecord/download` дописывается
# к нему. Учётной записи нужны ровно три права: «Скачивание записей
# разговоров», «Просмотр сотрудников», «Просмотр объекта» для проектов.
# Проверено 2026-09-09: адрес отвечает, сертификат валиден, без учётных данных
# отдаёт 401 с `WWW-Authenticate: Basic realm="Naumen Platform"`.
SPEECH_NCC_BASE_URL=https://telesales-service.nau.team:8443/api/v2
SPEECH_NCC_USERNAME=VolnaAPI
# Токен пользователя NCC. Создаётся один раз на карточке пользователя и
# повторно не показывается. Это секрет: он не попадает ни в репозиторий, ни в
# переписку, ни в задачи, ни в вывод тестов. Значение живёт только в локальном
# .env и в /srv/ai/app/.env на узле.
SPEECH_NCC_API_TOKEN=
# Скачивание записи — не запрос к справочнику: минуты разговора едут потоком.
SPEECH_NCC_TIMEOUT_SECONDS=60

# ВНИМАНИЕ: это НЕ наша база. Это отчётная база поставщика NCC
# (telesales-service.nau.team:5432, база telesales_rep) со своей учётной
# записью. Мы в ней только читаем: ничего не создаём, не мигрируем и не пишем.
#
# REST API NCC отдаёт запись по идентификатору сессии, но списка звонков в нём
# нет вовсе — список берётся из представлений этой базы
# (SPEECH_NCC_SOURCE_KIND=reporting_view).
#
# Адрес — без пароля, пароль — отдельной переменной. Это секрет: он живёт только
# в локальном .env и в /srv/ai/app/.env на узле. У сервера нет TLS (проверено
# 2026-09-15, принято владельцем): соединение пробует шифрование и при отказе
# идёт открытым текстом.
#
# Наша собственная база — это SPEECH_MS_DATABASE_URL выше.
# Пример: postgresql://telesales_volna@telesales-service.nau.team:5432/telesales_rep
SPEECH_NCC_REPORTING_DATABASE_URL=
SPEECH_NCC_REPORTING_DB_PASSWORD=
# Представления со звонками и имена проектов через запятую: <представление>=<проект>.
# Имя проекта попадает в карточку звонка: поле проекта в представлении пустое.
SPEECH_NCC_REPORTING_VIEWS=calls_detail=Волна,tss_7tel_calls_detail=7Телеком
# Часовой пояс времени в представлениях (timestamp without time zone).
SPEECH_NCC_REPORTING_TIMEZONE=Europe/Moscow
# Разговоры короче, в секундах, в приём не идут (speakingtime — в секундах).
SPEECH_NCC_MIN_TALK_SECONDS=10

# Откуда берётся суточный пакет: reporting_view | sequence | local_export | storage | rest.
#
# `reporting_view` — представления отчётной базы NCC выше: список звонков с
# оператором, временем, длительностью и классификацией обращения; запись — через
# REST. Источник для узла с 2026-09-15.
#
# `local_export` — каталог с выгрузкой, переданной колл-центром. Работает
# сейчас, на настоящих записях. Он знает идентификатор сессии, дату, аудио и
# классификацию обращения (её несёт дерево каталогов), но НЕ знает оператора,
# очередь и точное время начала — на этом источнике соответствующие фильтры
# пусты.
#
# `storage` — листинг объектного хранилища NCC по префиксу даты
# (`ncc-tm/ГГГГ/ММ/ДД/`). Объявлен и не реализован: ждёт адреса хранилища.
#
# Неизвестное значение и ненастроенный каталог останавливают прогон. Прогон,
# тихо решивший, что звонков за дату нет, выглядит как выходной день и
# обнаруживается только через неделю пустого поиска.
SPEECH_NCC_SOURCE_KIND=local_export
# Путь к каталогу выгрузки **на узле**. Настоящие записи — разговоры реальных
# клиентов, поэтому каталог живёт вне репозитория и в образ не попадает: он
# монтируется только для чтения в `/var/lib/speech/export`.
#
# Внутри контейнера путь закреплён и переменной не управляется — иначе
# приложение читало бы каталог, которого в контейнере нет, что и происходило,
# пока монтирования не было вовсе. При запуске без Docker (локальная разработка)
# каталог задаётся напрямую через `SPEECH_NCC_EXPORT_DIR`.
SPEECH_NCC_EXPORT_HOST_DIR=
SPEECH_NCC_EXPORT_DIR=
# UUID проектов NCC для SPEECH_NCC_SOURCE_KIND=rest, через запятую.
#
# Перечисления проектов в API нет — проверено на живой площадке: списка
# /projects не существует ни в v1, ни в v2, а все идентификаторы из
# /employees и /ous принадлежат сотрудникам и оргединицам. UUID берётся
# из адресной строки консоли NCC: .../published?uuid=<UUID>
# (руководство, раздел 6.1).
SPEECH_NCC_PROJECTS=
# Опорная сессия для SPEECH_NCC_SOURCE_KIND=sequence — обход сквозного счётчика.
# Любой недавний sessionId. HEAD /callrecord/download датирует сессии, не качая
# тела; обход от опорной точки восстанавливает список за период. Внимание:
# счётчик сквозной по всему кластеру (~60000 звонков/сутки, все арендаторы) —
# для только наших звонков дешевле SPEECH_NCC_PROJECTS + kind=rest.
SPEECH_NCC_SESSION_ANCHOR=
SPEECH_NCC_SESSION_DOMAINS=0,1,2,3
SPEECH_NCC_SESSION_NAUSS=0

# --- Хранилище аудиозаписей Speech Analytics --------------------------------
# MinIO находится на отдельной машине. Укажите адрес, доступный контейнеру.
# API читает записи для воспроизведения; отдельный воркер принимает и пишет их.
# Учётная запись ограничена одним бакетом; корневые ключи MinIO не используем.
SPEECH_STORAGE_BASE_URL=
SPEECH_STORAGE_BUCKET=speech-recordings
SPEECH_STORAGE_REGION=us-east-1
SPEECH_STORAGE_ACCESS_KEY_ID=
SPEECH_STORAGE_SECRET_KEY=
SPEECH_STORAGE_TIMEOUT_SECONDS=60
# Ключ к /metrics `speech-ms`. Пустой — ручки нет (404).
SPEECH_METRICS_KEY=

# --- Распознавание речи ------------------------------------------------------
# Свои настройки, а не общие `TRANSCRIPTION_*` (они в конце файла): у основного
# приложения распознавание на альфе выключено и смотрит в заглушку, а конвейеру
# нужен настоящий Whisper. Одна пара настроек на два назначения означала бы,
# что выключить одно нельзя, не выключив другое.
#
# Адрес — прокси на icai2, который единственный публикует порт; путь без
# завершающей косой черты, `/audio/transcriptions` дописывает клиент. С узла
# icai1 он доступен напрямую: фильтр пропускает к нему только этот адрес.
# С машины разработки — через туннель, см. документацию проекта.
SPEECH_WHISPER_BASE_URL=http://10.220.21.2:8002/v1
SPEECH_WHISPER_API_KEY=
SPEECH_WHISPER_MODEL=large-v3
SPEECH_WHISPER_LANGUAGE=ru
# Заведомо меньше аренды задания расшифровки (900 с): клиент обязан сдаться
# раньше, чем задание отберут по истечении аренды.
SPEECH_WHISPER_TIMEOUT_SECONDS=600
# `vad_filter` отсекает тишину. На телефонных записях, где пауз много, это
# заметно ускоряет обработку.
SPEECH_WHISPER_VAD_FILTER=true

# --- Подготовка запросов и прямой вызов LLM ---------------------------------
# Промпты и выбор модели принадлежат бэкенду. Адрес включает /v1.
SPEECH_ANALYSIS_LLM_BASE_URL=
SPEECH_ANALYSIS_LLM_API_KEY=
SPEECH_ANALYSIS_LLM_MODEL=qwen3.8-27b-fast
SPEECH_ANALYSIS_LLM_FREE_MODEL=qwen3.8-27b
# Модель-кандидат для compare-models должна отличаться от основной.
SPEECH_ANALYSIS_LLM_CANDIDATE_MODEL=
SPEECH_ANALYSIS_LLM_TIMEOUT_SECONDS=120
SPEECH_ANALYSIS_LLM_MAX_TOKENS=8192
# Один токен задаётся в бэкенде и воркере; в браузер не передаётся.
# Пустое значение закрывает /internal/v1/model-requests.
SPEECH_WORKER_API_TOKEN=
